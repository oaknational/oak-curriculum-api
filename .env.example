# Required — core API
# Oak Web Application (OWA) Hasura instance the API reads curriculum data from.
OAK_GRAPHQL_HOST=
OAK_GRAPHQL_SECRET=
# Upstash Redis, which holds API keys, rate limits and usage counters.
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
# Google Cloud Storage, which holds the lesson assets and bulk data.
# On Vercel the API authenticates by Workload Identity Federation and needs no
# key; these two are set by Terraform and are public identifiers, not secrets.
# The bulk pipeline uses the service account JSON instead.
# GCP_WIF_AUDIENCE=
# GCP_SERVICE_ACCOUNT_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Required for the /admin pages and API routes (HTTP Basic auth).
AUTH_USERNAME=some_unique_username
AUTH_PASSWORD=change_this_password

# Optional - for the bin/g command line helper — an API key issued from /admin.
# API_KEY=

# Optional — analytics. The API_* pair is used server-side, the plain pair by
# the browser client in src/lib/posthog.ts.
# NEXT_PUBLIC_POSTHOG_API_HOST=
# NEXT_PUBLIC_POSTHOG_API_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_POSTHOG_KEY=
# POSTHOG_API_HOST=
# POSTHOG_API_KEY=

# Optional — transcript search (Prisma Accelerate)
# PRISMA_ACCELERATE_DATABASE_URL=

# Optional — Sanity CMS, which supplies the docs and landing page content
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=
# NEXT_PUBLIC_SANITY_API_VERSION=

# SANITY_AUTH_SECRET=

# Optional — canonical origins. Defaults are in src/lib/baseUrl.ts.
# PRODUCTION_API_URL=
# VIDEO_URL=

# Optional — set to 1 to trace the asset download pipeline (credentials, bucket
# listing, URL signing) to the log. Chatty and on the hot path of every
# download, so leave it off outside a deployment you are debugging.
# ASSET_DEBUG_LOG=

# Optional — bulk download pipeline (see README_BULK_DOWNLOAD.md).
# Authenticates with GOOGLE_APPLICATION_CREDENTIALS_JSON, above.
# BUCKET_NAME=
# BULK_DATA_BUCKET=
# INCLUDE_ASSETS=
# MUX_TOKEN=

# Optional — load testing
# LOAD_TEST_TARGET_URL=
# OAK_API_AUTH_TOKEN=
