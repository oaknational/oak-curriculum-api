{
  "name": "oak-openapi",
  "version": "0.7.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "next build --webpack",
    "build-subjects": "tsx bin/build-subjects-and-key-stages.ts",
    "dev": "pnpm with-env next dev --port ${PORT:-2727} --webpack",
    "bulk": "NODE_OPTIONS='--max-old-space-size=4096' tsx bin/prepare-bulk.ts",
    "bulk:schema-check": "tsx bin/bulk-data-checks/run_checks.ts --schema ./src/app/api/bulk/schema.json/schema.json",
    "postinstall": "prisma generate --schema ./schema.prisma",
    "format:check": "prettier '**/*.{mj,j,t}{s,sx}' --check",
    "format": "prettier '**/*.{mj,j,t}{s,sx}' --write",
    "lint": "NEXT_TELEMETRY_DISABLED=1 NODE_DEBUG=http,https eslint src && tsc --noEmit",
    "ts": "tsc --noEmit",
    "check:env-example": "tsx bin/check-env-example.ts",
    "load-test": "pnpm with-env artillery run __tests__/load-tests.yml",
    "prepare": "husky",
    "test": "prisma generate --no-engine; NODE_OPTIONS=--no-deprecation pnpm with-env vitest",
    "test:vscode": "pnpm with-env vitest --no-file-parallelism --test-timeout=0",
    "with-env": "dotenv -e ./.env --",
    "test:all": "pnpm -r test",
    "gen-zod-from-gql": "tsx bin/zod-from-gql.ts"
  },
  "keywords": [],
  "author": "Oak National Academy",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@google-cloud/storage": "^8.1.0",
    "@next/eslint-plugin-next": "^16.3.4",
    "@oaknational/oak-components": "3.20.2",
    "@oaknational/oak-curriculum-schema": "^2.0.0",
    "@portabletext/react": "^8.0.1",
    "@prisma/client": "^5.22.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@sanity/icons": "^3.7.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "3",
    "@trpc/server": "^11.8.1",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.38.4",
    "graphql": "^16.11.0",
    "graphql-request": "^7.4.0",
    "highlight.js": "^11.11.1",
    "http-codes": "^1.0.0",
    "lodash": "^4.17.21",
    "next": "^16.3.4",
    "next-hubspot": "^2.0.0",
    "next-sanity": "9",
    "node-html-markdown": "^2.0.0",
    "object.groupby": "^1.0.3",
    "openapi-types": "^12.1.3",
    "openapi3-ts": "^4.5.0",
    "pg": "^8.14.0",
    "posthog-js": "^1.433.4",
    "posthog-node": "^5.52.3",
    "react-highlight": "^0.15.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "sanity": "^3.99.0",
    "slugify": "^1.6.6",
    "styled-components": "^6",
    "superjson": "^2.2.1",
    "swagger-ui-react": "^5.32.15",
    "tar-stream": "^3.2.1",
    "trpc-to-openapi": "3.3.0",
    "uuid": "^14.0.2",
    "vite-plugin-graphql-loader": "^4.0.4",
    "yazl": "^3.3.1",
    "zod": "^4.6.5",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "@prettier/plugin-xml": "^3.4.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@svgr/webpack": "^8.1.0",
    "@types/cors": "^2.8.17",
    "@types/http-codes": "^1.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash": "^4.17.15",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.11.6",
    "@types/pg-format": "^1.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-highlight": "^0.12.8",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/yazl": "^3.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.0.16",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.2.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.4.1",
    "prettier-plugin-embed": "^0.5.1",
    "prisma": "^5.21.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "renvy": "^4.1.0",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.16",
    "webpack-bugsnag-plugins": "^1.8.0"
  },
  "prettier": {
    "singleQuote": true,
    "useTabs": false
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
