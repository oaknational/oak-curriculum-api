#!/bin/bash

set -a
while IFS='=' read -r key value; do
  [ -z "${!key}" ] && export "$key=$value"
done < <(grep -v '^#' .env | grep -v '^\s*$')
set +a

ROOT=http://${HOST:-localhost}:${PORT:-2727}/api/v1

URL=$1

if [[ $1 == "prod" ]]; then
  ROOT=https://open-api.thenational.academy/api/v1
  URL=$2
  shift 2
elif [[ $2 != "" ]]; then
  ROOT=$1
  URL=$2
  shift 2
else
  shift 1
fi

if [[ $URL == "" ]]; then
  echo "Usage: $0 <endpoint>"
  exit 1
fi

# Prepend "/" to URL if it doesn't start with one
if [[ $URL != /* ]]; then
  URL="/$URL"
fi

if [ -t 1 ]; then
  curl -s -L -X 'GET' "$ROOT$URL" -H 'accept: application/json' -H "Authorization: Bearer $API_KEY" -D /dev/stderr "$@"
else
  curl -s "$ROOT$URL" -L -H 'accept: application/json' -H "Authorization: Bearer $API_KEY" "$@"
fi